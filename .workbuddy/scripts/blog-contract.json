{
  "version": "2.1",
  "updated": "2026-11-06",
  "purpose": "OE 站博客文章生成契约（v2）。选题/生成/评分/发布四个环节共用此文件，改规范只改这里。",
  "structure": {
    "min_words": 1400,
    "max_words": 4200,
    "min_h2": 8,
    "max_h2": 14,
    "min_paragraphs_per_h2": 2,
    "min_tables": 1,
    "min_faq": 4,
    "min_body_links": 6,
    "max_body_links": 30,
    "min_body_images": 4,
    "min_image_alt_len": 12,
    "require_quick_answer": true,
    "require_h1_unique": true,
    "forbid_empty_h2": true,
    "h2_style": "buyer_question",
    "min_h2_question_ratio": 0.55,
    "h2_question_markers": [
      "what",
      "which",
      "how",
      "why",
      "when",
      "who",
      "where"
    ],
    "h2_style_note": "H2 写成买家会问的问句（如 What identification must the buyer send?），不用陈述式小标题。这是兄弟站点 kingmay 最值得学的一条。"
  },
  "metadata": {
    "title_max": 70,
    "title_min": 25,
    "description_max": 160,
    "description_min": 70,
    "keywords_min": 3,
    "keywords_max": 8,
    "tags_min": 3,
    "tags_max": 6,
    "readtime_min": 5,
    "readtime_max": 20,
    "date_format": "YYYY-MM-DD"
  },
  "categories": [
